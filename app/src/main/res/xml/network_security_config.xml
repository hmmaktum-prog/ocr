<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ডিফল্টভাবে cleartext (HTTP) ট্রাফিক নিষেধ -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- শুধু localhost (llama-server) এর জন্য cleartext অনুমতি -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- HuggingFace model download — system CA trust ব্যবহার করা হয় (HTTPS) -->
    <!-- Certificate pinning ব্যবহার করা হয়নি কারণ pin expired/wrong হলে download সম্পূর্ণ বন্ধ হয়ে যায় -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">huggingface.co</domain>
    </domain-config>
</network-security-config>
